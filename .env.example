# ── Master Environment Configuration Reference ──────────────────────────

# Database Connection (PostgreSQL + pgvector)
# For local Standalone running:
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/agentdesk?schema=public"

# Redis Cache Connection
# For local Standalone running:
REDIS_URL="redis://localhost:6379"

# Security Tokens & Authentication Secrets
JWT_SECRET="agentdesk_super_secret_jwt_key_2026"

# LLM Providers (Groq API Key)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Web Client Public Backend Base URL
NEXT_PUBLIC_BACKEND_URL="http://localhost:3001/api"
